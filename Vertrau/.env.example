# Frontend Environment Variables — Expo
#
# Kopiere diese Datei zu `.env` und fülle die Werte ein.
# Expo lädt EXPO_PUBLIC_-Variablen automatisch und inlinet sie beim Build,
# d. h. sie liegen am Ende auch im JS-Bundle. Niemals Secrets hier ablegen.
# Alle drei Werte hier sind öffentliche Werte, die ohnehin im Frontend
# sichtbar sind (ANON_KEY ist nicht der Service-Role-Key!).

# Aus dem Supabase Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend-URL.
# - iOS-Simulator auf Mac:     http://localhost:3000
# - Android-Emulator auf Mac:  http://10.0.2.2:3000
# - Echtes Phone im WLAN:      http://192.168.XXX.XXX:3000
#   (Mac-IP rauskriegen via: ipconfig getifaddr en0)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
