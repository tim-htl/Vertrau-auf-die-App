// Prisma schema for the Vertrau-auf-die-App backend.
// Real models are added in Phase 1. The placeholder below exists so that
// `prisma generate` produces a usable client during Phase 0; it gets
// replaced once the real schema lands.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Placeholder {
  id Int @id @default(autoincrement())
}
