# Copy this file to `.env` and fill in real values from the Supabase dashboard.
# Never commit `.env` itself.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Supabase ---
# Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Prisma) ---
# Dashboard → Project Settings → Database → Connection string → URI
# Use the "Transaction" pooler URL (port 6543) for DATABASE_URL
# Use the "Session" / direct connection (port 5432) for DIRECT_URL
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
